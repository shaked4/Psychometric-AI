# Copy to .env.local and fill in the keys you have. Every integration below
# degrades gracefully when its keys are missing — the app stays fully
# functional in local/offline mode either way.

# AI Tutor (Claude API). Without it, /api/tutor and /api/generate-questions
# degrade to static fallback responses. Also required (together with the two
# Supabase keys below) to actually run `npm run seed:questions`
# (scripts/seed-question-bank.ts) — that script populates the shared exam
# question bank; `--dry-run` works without any keys at all.
ANTHROPIC_API_KEY=

# Auth (Clerk). Without both keys, the app runs in guest/local mode: the
# NavBar shows a "מצב אורח / מקומי" badge instead of sign-in, and no
# ClerkProvider is mounted at all.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloud persistence (Supabase). Without these, practice history stays in
# localStorage only — sign-in still works if Clerk is configured above, but
# nothing syncs to the cloud.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to the browser. The `attempts` table has Row
# Level Security enabled with zero policies, so the anon key above can never
# read or write it under any circumstance — all cloud sync goes through
# app/api/sync/push, which verifies the caller's Clerk session first, then
# writes with this service-role key (which bypasses RLS by design). This is
# what lets us skip building fine-grained RLS policies for the MVP while
# still keeping the table unreachable from the client.
SUPABASE_SERVICE_ROLE_KEY=
